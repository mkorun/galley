[
  "<a {#if link.urlPath === urlPath} aria-current=\"page\"{/if}>",
  "<a {#if template === 'page'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/docs/core-spec/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/docs/references-spec/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/conformance/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/docs/guide/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/docs/front-matter/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/packages/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/editors/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === '/docs/migrating-from-yaml/'} aria-current=\"page\"{/if}>",
  "<a {#if urlPath === link.urlPath} aria-current=\"page\"{/if}>",
  "<a {#if isDevBuild} data-hadley-head=\"title\"{/if}>",
  "<a {#if isDevBuild} data-hadley-head=\"subtitle\"{/if}>",
  "<a {#if article.isDraft} data-link-unpublished{/if}>",
  "<a {#if urlPath === '/ueber/'} aria-current=\"page\"{/if}>",
  "<a {#if item.isCurrent} class=\"series-current\" aria-current=\"true\"{/if}>",
  "<a {#if item.unpublished} data-link-unpublished{/if}>",
  "<a {#if meta.lang === 'de'} title=\"VG Wort: volle Ausschüttung (≥ 10.000)\"{/if}>",
  "<a {#if meta.lang === 'de'} title=\"VG Wort: unter 10.000 — kein Pixel sinnvoll\"{/if}>",
  "<a {#if meta.lang === 'de'} title=\"Kein VG-Wort-Pixel gesetzt — kein Anspruch auf Zugriffsausschüttung\"{/if}>",
  "<a {#if meta.lang === 'de'} title=\"VG Wort: Verbreitungsvergütung meldefähig (≥ 1.800)\"{/if}>",
  "<a {#if meta.lang === 'de'} title=\"VG Wort: nicht meldefähig (unter 1.800)\"{/if}>",
  "<a {#if site.theme.colorScheme !== 'auto'} data-color-scheme=\"{ site.theme.colorScheme }\"{/if}>",
  "<a {#if meta.coverStyle} data-style=\"{ meta.coverStyle }\"{/if}>",
  "<a {#if isAiCover} data-ai-generated data-ai-label=\"{ t.image.aiGenerated }\"{/if}>",
  "<a {#if site.theme.colorToggle} data-color-toggle{/if}>",
  "<a {#if template === 'home'} aria-current=\"page\"{/if}>",
  "<a {#if item.isAiCover} data-ai-generated{/if}>",
  "<a {#if isAiCover} data-ai-generated{/if}>",
  "<a class=\"{#if ed.invertDark} editor-logo--invert-dark{/if}\">",
  "<a title=\"{#if coverAiTool} ({ coverAiTool }){/if}\">",
  "<a class=\"{#if comment.author_reply} comment--author{/if}\">",
  "<a aria-label=\"{#if article.year}{ article.year }{:else}{ t.home.undatedYear }{/if}\">",
  "<a class=\"{#if article.status === 'scheduled'} entry-badge--scheduled{/if}\">",
  "<a content=\"{#if site.claim} · { site.claim }{/if}\">",
  "<a class=\"{#if meta.category} badge-cat--{ meta.category }{/if}\">",
  "<a class=\"{#if item.category} badge-cat--{ item.category }{/if}\">",
  "<a class=\"{#if item.isSeries} post-featured--series{/if}\">",
  "<a class=\"{#if article.category} badge-cat--{ article.category }{/if}\">",
  "<a class=\"{#if template === 'home'} masthead--home{/if}\">",
  "<a class=\"{#if !item.cover} card--text{/if}\">",
  "<a class=\"{#if html.cover} hero--image{/if}\">",
  "<a data-cover=\"{#if item.cover}{ item.cover.src } { item.cover.width }x{ item.cover.height } {#each item.cover.sources as source}{ source.type }={ source.srcset };{/each}{:else}none{/if}\">",
  "<title>{ htmlTitle }</title>",
  "<title>{ site.title } · { t.feed.title }</title>",
  "<title>{ meta.title }</title>",
  "<a{#if a} aria-current=\"page\"{/if}{#if b} data-link-unpublished{/if}>x</a>",
  "<a href=\"/x\"\n  {#if a} aria-current=\"page\"{/if}\n  {#if b} data-link-unpublished{/if}\n>x</a>",
  "<a class=\"nav\"{#if a} aria-current=\"page\"{/if} href=\"{ u }\">x</a>",
  "<svg><title>{ t.close }</title></svg>",
  "<svg viewBox=\"0 0 1 1\"><use xlink:href=\"{ u }\"/></svg>",
  "<html lang=\"de\"{#if site.theme.colorScheme !== 'auto'} data-color-scheme=\"{ site.theme.colorScheme }\"{/if}{#if site.theme.colorToggle} data-color-toggle{/if}>"
]
